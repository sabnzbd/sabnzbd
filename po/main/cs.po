#. Notification - Status page, table column header, actual message
#: SABnzbd.py, sabnzbd/notifier.py, sabnzbd/skintext.py
msgid "Warning"
msgstr "Varování"

#. Notification
#: SABnzbd.py, sabnzbd/notifier.py
msgid "Error"
msgstr "Chyba"

#. Error message
#: SABnzbd.py
msgid "Failed to start web-interface"
msgstr "Nezdařilo se spustit webové rozhraní"

#. Warning message
#: SABnzbd.py
msgid "Cannot find web template: %s, trying standard template"
msgstr "Šablona pro web nebyla nalezena: %s, zkouším standardní šablonu"

#. Warning message
#: SABnzbd.py
msgid ""
"Unable to link to OpenSSL, optimized SSL connection functions will not be "
"used."
msgstr ""
"Nelze navázat spojení s OpenSSL, proto nebudou použity optimalizované funkce"
" pro SSL připojení."

#. Error message
#: SABnzbd.py
msgid ""
"SABCTools disabled: no correct version found! (Found v%s, expecting v%s)"
msgstr ""
"SABCTools vypnut: Nenalezena správná verze! (Nalezena v%s, očekávána v%s)"

#. Error message
#: SABnzbd.py
msgid "par2 binary... NOT found!"
msgstr "Program par2... nenalezen!"

#. Warning message
#: SABnzbd.py
msgid "Your UNRAR version is %s, we recommend version %s or higher.<br />"
msgstr ""
"Vaše verze programu UNRAR je %s, doporučujeme verzi %s nebo vyšší. <br />"

#. Error message
#: SABnzbd.py
msgid "unrar binary... NOT found"
msgstr "Program unrar... nenalezen!"

#. Warning message
#: SABnzbd.py
msgid "7za binary... NOT found!"
msgstr "Program 7za... nenalezen!"

#. Error message
#: SABnzbd.py
msgid "Essential modules are missing, downloading cannot start."
msgstr "Chybí nezbytné moduly, stahování nelze spustit."

#. Warning message
#: SABnzbd.py
msgid ""
"Please be aware the 0.0.0.0 hostname will need an IPv6 address for external "
"access"
msgstr ""
"Vezměte prosím na vědomí, že pro hostitelské jméno 0.0.0.0 bude pro externí "
"přístup zapotřebí adresa IPv6."

#. Error message
#: SABnzbd.py
msgid "HTTP and HTTPS ports cannot be the same"
msgstr "Porty HTTP a HTTPS se nesmí shodovat"

#. Warning message
#: SABnzbd.py
msgid "Could not load additional certificates from certifi package"
msgstr "Nepodařilo se načíst další certifikáty z balíčku certifi"

#. Warning message
#: SABnzbd.py
msgid "Disabled HTTPS because of missing CERT and KEY files"
msgstr "HTTPS bylo deaktivováno kvůli chybějícím souborům CERT a KEY"

#. Warning message
#: SABnzbd.py
msgid "Disabled HTTPS because of invalid CERT and KEY files"
msgstr "HTTPS byl deaktivován z důvodu neplatných souborů CERT a KEY"

#. Error message
#: SABnzbd.py
msgid "Failed to start web-interface: "
msgstr "Nepodařilo se spustit webové rozhraní:"

#: SABnzbd.py
msgid "SABnzbd %s started"
msgstr "SABnzbd %s spustěno"

#: SABnzbd.py, sabnzbd/interface.py
msgid "SABnzbd shutdown finished"
msgstr "Ukončení činnosti programu SABnzbd bylo dokončeno"

#: sabnzbd/__init__.py
msgid "Signal %s caught, saving and exiting..."
msgstr "Zaznamenán signál %s, ukládání a ukončení..."

#. Error message
#: sabnzbd/__init__.py
msgid "Fatal error at saving state"
msgstr "Závažná chyba při ukládání stavu"

#. Warning message
#: sabnzbd/__init__.py
msgid ""
"SABnzbd was started with encoding %s, this should be UTF-8. Expect problems "
"with Unicoded file and directory names in downloads."
msgstr ""
"Program SABnzbd byl spuštěn s nastavením kódování %s; mělo by se jednat o "
"UTF-8. Očekávejte problémy se soubory a názvy adresářů v Unicode ve "
"stažených souborech."

#. Warning message
#: sabnzbd/__init__.py
msgid ""
"Current umask (%o) might deny SABnzbd access to the files and folders it "
"creates."
msgstr ""
"Aktuální hodnota funkce umask(%o) může bránit programu SABnzbd v přístupu k "
"souborům a složkám, které vytváří."

#. Warning message
#: sabnzbd/__init__.py
msgid "Windows ARM version of SABnzbd is available from our Downloads page!"
msgstr ""
"Verze SABnzbd pro Windows ARM je k dispozici na naší stránce ke stažení!"

#. Warning message
#: sabnzbd/__init__.py
msgid ""
"Completed Download Folder %s is on FAT file system, limiting maximum file "
"size to 4GB"
msgstr ""
"Složka s dokokončenými stahováními %s je na souborovém systému FAT, což "
"omezuje maximální velikost souboru na 4 GB"

#. Warning message
#: sabnzbd/__init__.py
msgid "Restarting because of crashed postprocessor"
msgstr "Restartování z důvodu selhání postprocesoru"

#. Warning message
#: sabnzbd/__init__.py
msgid "Restarting because of crashed downloader"
msgstr "Restartování z důvodu selhání stahovacího programu"

#. Warning message
#: sabnzbd/__init__.py
msgid "Restarting because of crashed assembler"
msgstr "Restartování z důvodu selhání assembleru"

#. Warning message
#: sabnzbd/__init__.py
msgid "Cannot access PID file %s"
msgstr "Nelze otevřít soubor PID %s"

#: sabnzbd/api.py, sabnzbd/emailer.py
msgid "Email succeeded"
msgstr "Odeslání e-mailu se podařilo"

#: sabnzbd/api.py, sabnzbd/skintext.py
msgid "Test Notification"
msgstr "Otestovat oznámení"

#: sabnzbd/api.py
msgid "The hostname is not set."
msgstr "Název hostitele není nastaven."

#: sabnzbd/api.py
msgid "There are no connections set. Please set at least one connection."
msgstr ""
"Není nastaveno žádné připojení. Nastavte prosím alespoň jedno připojení."

#: sabnzbd/api.py
msgid "Password masked in ******, please re-enter"
msgstr "Heslo je skryto za znaky ******, zadejte jej prosím znovu"

#: sabnzbd/api.py
msgid "Invalid server details"
msgstr "Neplatné údaje o serveru"

#: sabnzbd/api.py
msgid ""
"Could not connect to %s on port %s. It appears that %s operates as a web "
"server (port 80), possibly an indexer, not a usenet server. You have to fill"
" a usenet server."
msgstr ""
"Nepodařilo se navázat spojení s %s na portu %s. Zdá se, že %s funguje jako "
"webový server (port 80), možná jako indexační server, nikoli jako server "
"Usenetu. Musíte zadat server Usenetu."

#: sabnzbd/api.py
msgid ""
"Could not connect to %s on port %s. Use the default usenet settings: port "
"563 and SSL turned on"
msgstr ""
"Nelze se připojit k %s na portu %s. Použijte výchozí nastavení Usenetu: port"
" 563 a zapnutý protokol SSL"

#: sabnzbd/api.py
msgid ""
"Could not connect to %s on port %s. Use the default usenet settings: port "
"119 and SSL turned off"
msgstr ""
"Nelze se připojit k %s na portu %s. Použijte výchozí nastavení Usenetu: port"
" 119 a vypnutý protokol SSL"

#: sabnzbd/api.py, sabnzbd/interface.py
msgid "Server address \"%s:%s\" is not valid."
msgstr "Adresa serveru \"%s:%s\" není platná."

#: sabnzbd/api.py
msgid "Timed out: Try enabling SSL or connecting on a different port."
msgstr ""
"Vypršel časový limit: Zkuste povolit protokol SSL nebo se připojit přes jiný"
" port."

#: sabnzbd/api.py
msgid "Timed out"
msgstr "Vypršel časový limit"

#: sabnzbd/api.py
msgid ""
"Unknown SSL protocol: Try disabling SSL or connecting on a different port."
msgstr ""
"Neznámý protokol SSL: Zkuste vypnout SSL nebo se připojit přes jiný port."

#: sabnzbd/api.py
msgid "Could not determine connection result (%s)"
msgstr "Nelze určit výsledek připojení (%s)"

#: sabnzbd/api.py
msgid "Server requires username and password."
msgstr "Server vyžaduje zadání uživatelského jména a hesla."

#: sabnzbd/api.py
msgid "Connection Successful!"
msgstr "Připojení proběhlo úspěšně!"

#: sabnzbd/api.py, sabnzbd/interface.py
msgid "Authentication failed, check username/password."
msgstr "Ověření se nezdařilo, zkontrolujte uživatelské jméno a heslo."

#: sabnzbd/api.py
msgid "Too many connections, please pause downloading or try again later"
msgstr ""
"Příliš mnoho připojení – pozastavte prosím stahování nebo to zkuste znovu "
"později"

#. Warning message
#: sabnzbd/api.py
msgid ""
"Server %s took %d ms to respond. On high-latency connections, increasing "
"'Articles per request' to a value between 5 and 10 can improve download "
"speed. See: https://sabnzbd.org/wiki/advanced/nntp-pipelining"
msgstr ""

#: sabnzbd/api.py
msgid "Resolving address"
msgstr "Překládám adresu"

#. No value, used in dropdown menus
#: sabnzbd/api.py, sabnzbd/skintext.py
msgid "None"
msgstr "Žádné"

#. Default value, used in dropdown menus
#: sabnzbd/api.py, sabnzbd/interface.py, sabnzbd/skintext.py
msgid "Default"
msgstr "Výchozí"

#. Error message
#: sabnzbd/assembler.py, sabnzbd/decoder.py
msgid "Disk full! Forcing Pause"
msgstr "Disk je plný! Vynucení pozastavení"

#. Error message
#: sabnzbd/assembler.py, sabnzbd/decoder.py
msgid "Disk error on creating file %s"
msgstr "Probém s vytvořením souboru %s na disku"

#. Error message
#: sabnzbd/assembler.py
msgid "Fatal error in Assembler"
msgstr "Závažná chyba v assembleru"

#. Warning message
#: sabnzbd/assembler.py
msgid "Too little diskspace forcing PAUSE"
msgstr "Příliš málo místa na disku způsobuje stav POZASTAVIT"

#. Warning message
#: sabnzbd/assembler.py
msgid ""
"Paused job \"%s\" because of encrypted RAR file (if supplied, all passwords "
"were tried)"
msgstr ""
"Úloha „%s“ byla pozastavena kvůli zašifrovanému souboru RAR ( byla "
"vyzkoušena všechna dodaná hesla)"

#. Warning message
#: sabnzbd/assembler.py
msgid ""
"Aborted job \"%s\" because of encrypted RAR file (if supplied, all passwords"
" were tried)"
msgstr ""
"Úloha „%s“ byla přerušena kvůli zašifrovanému souboru RAR ( byla vyzkoušena "
"všechna dodaná hesla)"

#: sabnzbd/assembler.py
msgid "Aborted, encryption detected"
msgstr "Zrušeno, zjištěno šifrování"

#. Warning message
#: sabnzbd/assembler.py
msgid "In \"%s\" unwanted extension in RAR file. Unwanted file is %s "
msgstr ""
"V souboru RAR „%s“ se nachází  nežádoucí přípona. Nežádoucí soubor je %s"

#: sabnzbd/assembler.py
msgid "Unwanted extension is in rar file %s"
msgstr "V souboru RAR se nachází nežádoucí příloha %s"

#: sabnzbd/assembler.py, sabnzbd/nzb/object.py
msgid "Aborted, unwanted extension detected"
msgstr "Přerušeno, nalezena nežádoucí připona"

#. Warning message
#: sabnzbd/assembler.py
msgid "Job \"%s\" is probably encrypted due to RAR with same name inside this RAR"
msgstr ""
"Soubor „%s“ je pravděpodobně zašifrován, protože v tomto archivu RAR se "
"nachází soubor RAR se stejným názvem."

#. Warning message
#: sabnzbd/assembler.py
msgid "Job \"%s\" is probably encrypted: \"password\" in filename \"%s\""
msgstr ""
"Položka „%s“ je pravděpodobně zašifrována: „heslo“ v názvu souboru „%s“"

#. Warning message
#: sabnzbd/bpsmeter.py
msgid "Quota spent, pausing downloading"
msgstr "Kvóta vyčerpána, stahování se pozastavilo"

#. Warning message - Notification
#: sabnzbd/bpsmeter.py, sabnzbd/downloader.py, sabnzbd/notifier.py,
#: sabnzbd/skintext.py
msgid "Quota"
msgstr "Kvóta"

#: sabnzbd/bpsmeter.py
msgid "Quota limit warning (%d%%)"
msgstr "Upozornění na překročení kvóty (%d%%)"

#: sabnzbd/bpsmeter.py
msgid "Downloading resumed after quota reset"
msgstr "Stahování pokračovalo po vynulování kvóty"

#: sabnzbd/cfg.py, sabnzbd/interface.py
msgid "Incorrect parameter"
msgstr "Nesprávný parametr"

#: sabnzbd/cfg.py
msgid "%s is not a valid email address"
msgstr "%s není platná e-mailová adresa"

#: sabnzbd/cfg.py, sabnzbd/interface.py
msgid "Server address required"
msgstr "Je nutná adresa serveru"

#: sabnzbd/cfg.py, sabnzbd/newswrapper.py
msgid "Invalid server address."
msgstr "Neplatná adresa serveru."

#: sabnzbd/cfg.py
msgid "%s is not a valid script"
msgstr "%s není platný skript"

#: sabnzbd/cfg.py
msgid "%s is not a correct octal value"
msgstr "%s není hodnota v osmičkové soustavě"

#. Warning message
#: sabnzbd/cfg.py
msgid ""
"Permissions setting of %s might deny SABnzbd access to the files and folders"
" it creates."
msgstr ""
"Nastavení oprávnění %s může SABnzbd odepřít přístup k souborům a složkám, "
"které vytváří."

#. Warning message
#: sabnzbd/cfg.py
msgid "Network path \"%s\" should not be used here"
msgstr "Síťová cesta „%s“ by se zde neměla používat"

#: sabnzbd/cfg.py
msgid "Queue not empty, cannot change folder."
msgstr "Fronta není prázdná, nelze změnit složku."

#: sabnzbd/cfg.py
msgid ""
"The Completed Download Folder cannot be the same or a subfolder of the "
"Temporary Download Folder"
msgstr ""
"Složka pro stažené soubory nesmí být stejná jako složka pro dočasné "
"stahování ani její podsložka."

#. Warning message
#: sabnzbd/cfg.py
msgid ""
"Do not use a folder in the application folder as your Scripts Folder, it "
"might be emptied during updates."
msgstr ""
"Jako složku pro skripty nepoužívejte žádnou složku v aplikační složce, "
"protože by mohla být při aktualizacích vyprázdněna."

#. Warning message
#: sabnzbd/cfg.py
msgid ""
"The par2 application was switched, any custom par2 parameters were removed"
msgstr ""
"Aplikace par2 byla přepnuta, veškeré vlastní parametry par2 byly odstraněny"

#. Warning message
#: sabnzbd/config.py
msgid "Configuration locked, cannot save settings"
msgstr "Konfigurace je uzamčena, nastavení nelze uložit"

#. Error message
#: sabnzbd/config.py
msgid "Cannot write to INI file %s"
msgstr "Nelze zapisovat do INI souboru %s"

#. Error message
#: sabnzbd/config.py
msgid "Cannot create backup file for %s"
msgstr "Nelze vytvořit záložní soubor pro %s"

#. Warning message
#: sabnzbd/config.py
msgid "Could not restore backup"
msgstr "Nepodařilo se obnovit zálohu"

#. Error message
#: sabnzbd/config.py
msgid "Incorrectly encoded password %s"
msgstr "Nesprávně zadané heslo %s"

#. Error message
#: sabnzbd/database.py
msgid "Cannot write to History database, check access rights!"
msgstr "Nelze zapisovat do databáze historie, zkontrolujte přístupová práva!"

#. Error message
#: sabnzbd/database.py
msgid "Damaged History database, created empty replacement"
msgstr "Poškozená databáze historie, nahraďte prázdnou databází"

#. Error message
#: sabnzbd/database.py
msgid "SQL Command Failed, see log"
msgstr "Spustění SQL příkazu selhalo, zkontrolujte záznamy"

#. Error message
#: sabnzbd/database.py
msgid "Failed to close database, see log"
msgstr "Nezdařilo se uzavření databáze, zkontrolujte záznamy"

#. Warning message
#: sabnzbd/database.py
msgid "Invalid stage logging in history for %s"
msgstr "Neplatný záznam o fázi v historii pro %s"

#. Warning message
#: sabnzbd/decoder.py
msgid "Decoder failure: Out of memory"
msgstr "Chyba dekodéru: Nedostatek paměti"

#. Warning message
#: sabnzbd/decoder.py
msgid "Unknown Error while decoding %s"
msgstr "Při dekódování došlo k neznámé chybě %s"

#: sabnzbd/deobfuscate_filenames.py
msgid "Deobfuscate skipped due to DVD/Bluray directories"
msgstr "Odstranění kódování bylo přeskočeno kvůli adresářům DVD/Blu-ray"

#: sabnzbd/deobfuscate_filenames.py
msgid "Deobfuscate corrected the extension of %d file(s)"
msgstr "Funkce Odstranit zamaskování opravila příponu souboru (souborů) %d"

#: sabnzbd/deobfuscate_filenames.py
msgid "Deobfuscate renamed %d file(s)"
msgstr "Odstranit zamaskování %d přejmenovaných souborů"

#: sabnzbd/deobfuscate_filenames.py
msgid "Deobfuscate renamed %d subtitle file(s)"
msgstr "Obnovit původní názvy přejmenovaných souborů s titulky"

#: sabnzbd/directunpacker.py, sabnzbd/skintext.py
msgid "Direct Unpack"
msgstr "Přímé rozbalení"

#. PP status
#: sabnzbd/directunpacker.py, sabnzbd/skintext.py
msgid "Completed"
msgstr "Dokončeno"

#: sabnzbd/directunpacker.py, sabnzbd/newsunpack.py
msgid "Unpacked %s files/folders in %s"
msgstr "Soubory/složky %s rozbaleny do %s"

#. Warning message
#: sabnzbd/directunpacker.py
msgid "Direct Unpack was automatically enabled."
msgstr "Přímé rozbalení bylo automaticky zapnuto."

#: sabnzbd/directunpacker.py, sabnzbd/skintext.py
msgid ""
"Jobs will start unpacking during the downloading to reduce post-processing "
"time. Only works for jobs that do not need repair."
msgstr ""
"Úlohy se začnou rozbalovat již během stahování, aby se zkrátila doba "
"následného zpracování. Funguje to pouze u úloh, které nevyžadují opravu."

#. Error message
#: sabnzbd/dirscanner.py
msgid "Cannot read Watched Folder %s"
msgstr "Nelze číst ze \"Sledované\" složky %s"

#: sabnzbd/downloader.py
msgid "Resuming"
msgstr "Obnovování"

#. PP status - Priority pick list
#: sabnzbd/downloader.py, sabnzbd/macosmenu.py, sabnzbd/sabtraylinux.py,
#: sabnzbd/sabtraywin.py, sabnzbd/skintext.py
msgid "Paused"
msgstr "Pozastaveno"

#. Warning message
#: sabnzbd/downloader.py, sabnzbd/skintext.py
msgid "You must set a maximum bandwidth before you can set a bandwidth limit"
msgstr ""
"Než budete moci nastavit limit šířky pásma, musíte nejprve nastavit "
"maximální šířku pásma"

#: sabnzbd/downloader.py
msgid "Cannot connect to server %s [%s]"
msgstr "Nelze se připojit k serveru %s [%s]"

#: sabnzbd/downloader.py, sabnzbd/urlgrabber.py
msgid "Server name does not resolve"
msgstr "Nebylo možné přeložit jméno serveru"

#. Warning message
#: sabnzbd/downloader.py
msgid "Server %s will be ignored for %s minutes"
msgstr "Server %s bude ignorován po dobu %s minut"

#. Warning message
#: sabnzbd/downloader.py
msgid "There are no active servers!"
msgstr "Žádné servery nejsou v provozu!"

#. Error message
#: sabnzbd/downloader.py
msgid "Failed to initialize %s@%s with reason: %s"
msgstr "Inicializace %s@%s se nezdařila z následujícího důvodu: %s"

#. Error message
#: sabnzbd/downloader.py
msgid "Fatal error in Downloader"
msgstr "Závažná chyba ve Stahování"

#: sabnzbd/downloader.py
msgid "Too many connections to server %s [%s]"
msgstr "Příliš mnoho spojení k serveru %s [%s]"

#: sabnzbd/downloader.py
msgid ""
"Login from too many different IP addresses to server %s [%s] - "
"https://sabnzbd.org/multiple-adresses"
msgstr ""
"Příliš mnoho přihlášení ze různých IP adres na server %s [%s] – "
"https://sabnzbd.org/multiple-adresses"

#: sabnzbd/downloader.py
msgid "Failed login for server %s [%s]"
msgstr "Přihlášení k serveru %s se nezdařilo [%s]"

#. Error message
#: sabnzbd/downloader.py
msgid "Connecting %s@%s failed, message=%s"
msgstr "Připojení %s@%s se nezdařilo, zpráva=%s"

#. Warning message
#: sabnzbd/downloader.py
msgid ""
"Total number of configured connections (%d) is greater than the operating "
"system limit (512), downloading will crash if all connections become active"
msgstr ""
"Celkový počet nakonfigurovaných připojení (%d) přesahuje limit operačního "
"systému (512); pokud se všechna připojení stanou aktivními, stahování se "
"přeruší"

#: sabnzbd/downloader.py, sabnzbd/skintext.py
msgid "Shutting down"
msgstr "Vypínání"

#. Warning message
#: sabnzbd/downloader.py
msgid "Server %s is expiring in %s day(s)"
msgstr "Server %s vyprší za %s dnů"

#. Warning message
#: sabnzbd/downloader.py
msgid "Server %s has used the specified quota"
msgstr "Server %s vyčerpal nastavenou kvótu"

#: sabnzbd/emailer.py
msgid "Failed to connect to mail server"
msgstr "Připojení k poštovnímu serveru se nezdařilo"

#: sabnzbd/emailer.py
msgid "Failed to initiate TLS connection"
msgstr "Nezdařilo se inicializovat TLS spojení"

#: sabnzbd/emailer.py
msgid "The server didn't reply properly to the helo greeting"
msgstr "Server neodpověděl správně na pozdrav „helo“"

#: sabnzbd/emailer.py
msgid "Failed to authenticate to mail server"
msgstr "Nepodařilo se ověřit u poštovního serveru"

#: sabnzbd/emailer.py
msgid "No suitable authentication method was found"
msgstr "Nebyla nalezena žádná vhodná metoda ověření"

#: sabnzbd/emailer.py
msgid "Unknown authentication failure in mail server"
msgstr "Neznámá chyba ověření na poštovním serveru"

#: sabnzbd/emailer.py
msgid "Failed to send e-mail"
msgstr "Odeslání e-mailu se nezdařilo"

#: sabnzbd/emailer.py
msgid "Failed to close mail connection"
msgstr "Nepodařilo se uzavřít poštovní připojení"

#: sabnzbd/emailer.py, sabnzbd/notifier.py
msgid "Cannot send, missing required data"
msgstr "Nelze odeslat, chybí povinné údaje"

#. Error message
#: sabnzbd/emailer.py
msgid "Cannot find email templates in %s"
